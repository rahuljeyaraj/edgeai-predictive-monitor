[Unit]
Description=Root-owned bridge exposing WiFi onboarding (nmcli/wlan0) to the app container over a Unix socket
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/wifi_bridge.py
Restart=on-failure
RestartSec=1
User=root

[Install]
WantedBy=multi-user.target
