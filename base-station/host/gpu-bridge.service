[Unit]
Description=Root-owned bridge exposing the GPU's debugfs busy% counter to the app container over a Unix socket
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/gpu_bridge.py
Restart=on-failure
RestartSec=1
User=root

[Install]
WantedBy=multi-user.target
